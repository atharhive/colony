# Telegraph Node Endpoints
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com/engine

# Payment Configuration (Ethereum Sepolia Testnet)
# Escrow is the rail Colony uses: one signed message per ask, billed to the escrow balance.
TELEGRAPH_PAYMENT=escrow
# The Diamond that /engine/v1/ask settles to. Deposits made to the older
# 0x3624EB012B5E998BB57B6bE6C9Cfc9c4bc5eb99b do not carry over.
TELEGRAPH_DIAMOND=0x72a70e949362670Bf8bceAd24eFC5b8f950aa08b
TELEGRAPH_CHAIN_ID=11155111

# Optional: a burner key for scripts. CLI runs read ~/.telegraph/wallet.json by default.
# Never commit a real key.
TELEGRAPH_PRIVATE_KEY=
